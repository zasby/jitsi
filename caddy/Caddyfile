connect.mooz.pro {
  tls /etc/ssl/certs/connect.mooz.pro.crt /etc/ssl/private/connect.mooz.pro.key
  encode zstd gzip

  # XMPP → Prosody (по префиксу, чтобы не было 404 от web)
  handle_path /xmpp-websocket* {
    reverse_proxy prosody:5280
  }

  handle_path /http-bind* {
    reverse_proxy prosody:5280
  }

  # Не кэшировать конфиг на клиентах/прокси; отдаем файл из /srv
  handle_path /config.js {
    header {
      Cache-Control "no-store, no-cache, must-revalidate"
    }
    root * /srv
    file_server
  }

  # Всё остальное → официальный jitsi/web (nginx внутри)
  reverse_proxy web:80

  header {
    Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
    X-Content-Type-Options "nosniff"
    X-Frame-Options "SAMEORIGIN"
    Referrer-Policy "strict-origin-when-cross-origin"
  }
}


