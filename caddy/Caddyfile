connect.mooz.pro {
  tls /etc/ssl/certs/connect.mooz.pro.crt /etc/ssl/private/connect.mooz.pro.key
  encode zstd gzip

  # XMPP → Prosody (не отрезаем префикс!)
  @xmpp_ws path /xmpp-websocket /xmpp-websocket/*
  reverse_proxy @xmpp_ws prosody:5280 {
    header_up Host {host}
  }

  @bosh path /http-bind /http-bind/*
  reverse_proxy @bosh prosody:5280 {
    header_up Host {host}
  }

  # Не кэшировать конфиг на клиентах/прокси; отдаем файл из /srv
  @cfg path /config.js
  header @cfg Cache-Control "no-store, no-cache, must-revalidate"
  handle @cfg {
    root * /srv
    file_server
  }

  # Всё остальное → официальный jitsi/web (nginx внутри)
  reverse_proxy web:80

  header {
    Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
    X-Content-Type-Options "nosniff"
    X-Frame-Options "SAMEORIGIN"
    Referrer-Policy "strict-origin-when-cross-origin"
  }
}


